# --- required ---
DATABASE_URL=postgres://USER@localhost:5432/coveragecheck?sslmode=disable
PORT=8080
CORS_ORIGIN=http://localhost:5173

# --- Stedi clearinghouse (X12 270/271) ---
# mock = local simulator reproducing Stedi's documented test scenarios (no key needed)
# live = real sandbox calls; requires a TEST API key from stedi.com
STEDI_MODE=mock
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com/2026-06-01
PROVIDER_NPI=1999999984
PROVIDER_NAME=Riverside Dental Care

# --- LLM brief (OpenRouter). Leave empty to use the deterministic template brief. ---
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# --- orchestration ---
MAX_WORKERS=20          # bounded worker pool
MAX_ATTEMPTS=3          # retry budget before manual review
RETRY_BASE=15s          # first backoff; doubles each attempt (+ deterministic jitter)
PAYER_RPS=5             # outbound per-payer token bucket
PAYER_BURST=5
MOCK_LATENCY_MIN=250ms
MOCK_LATENCY_MAX=900ms
MOCK_FAIL_RATE=0.03     # synthetic-load only: simulated transient payer failures

# --- pre-visit cost notices ---
PRACTICE_PHONE=+91 98765 43210
NIGHTLY_HOUR=18          # local hour the pre-visit run fires for tomorrow's appointments
TIMEZONE=Asia/Kolkata
# Email delivery — pick ONE. Leave both empty to log notices in-app only (demo-safe default).
# Option A: Gmail SMTP (no signup). Google Account -> Security -> 2-Step Verification -> App passwords -> create one.
SMTP_HOST=               # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=               # you@gmail.com
SMTP_PASS=               # the 16-character App Password (NOT your Gmail password)
SMTP_FROM=               # optional display name, e.g. "Riverside Dental Care <you@gmail.com>"
# Option B: Resend (resend.com). Free tier sends only to your own verified address unless you verify a domain.
RESEND_API_KEY=
RESEND_FROM=             # optional sender, e.g. "Riverside Dental <notices@yourdomain.com>"

# --- AI voice verification (payers with no real-time 270/271) ---
# mock (default): no calls are placed; a deterministic stand-in drives the exact same
# completion path so the UI/pipeline can be demoed. live: real outbound calls.
VOICE_MODE=mock
VOICE_PROVIDER=bolna         # bolna (India-native; default numbers dial +91) | retell (US)
VOICE_CALL_TIMEOUT=10m       # CALL_IN_PROGRESS longer than this -> Manual Review (call_timeout)
VOICE_MOCK_DELAY=8s          # mock only: how long a simulated call "lasts"
# Bolna (https://bolna.ai): create an agent from GET /api/voice/agent-spec?baseUrl=<public URL>
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=           # optional: a connected Exotel/Plivo number for a +91 caller ID
VOICE_WEBHOOK_SECRET=        # any long random string; Bolna's callbacks are authenticated with it
# Retell alternative
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# --- email-form verification (payers with no phone line, only an email) ---
EMAIL_FORM_BASE_URL=http://localhost:8080  # public origin the emailed form link points to; set to your ngrok/real domain to go live
EMAIL_RESPONSE_TIMEOUT=72h                 # unanswered email -> Manual Review after this long
